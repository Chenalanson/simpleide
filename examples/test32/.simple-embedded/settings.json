{
  "version": 1,
  "build": {
    "target": "Local",
    "build_command": "mingw32-make",
    "clean_command": "mingw32-make clean",
    "rebuild_command": "mingw32-make clean && mingw32-make",
    "flash_command": "",
    "flash_tool": "openocd",
    "openocd": {
      "executable": "C:\\openocd-20260302\\OpenOCD-20260302-0.12.0\\bin\\openocd.exe",
