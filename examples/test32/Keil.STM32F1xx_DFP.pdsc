<?xml version="1.0" encoding="UTF-8"?>
<package schemaVersion="1.4" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <name>Keil.STM32F1xx_DFP</name>
  <vendor>Keil</vendor>
  <description>STM32F1 Series Device Family Pack</description>
  <url>https://www.keil.com/dd2/pack/</url>
  <releases>
    <release version="2.4.1" date="2024-05-24">Device support for STM32F1 Series.</release>
  </releases>
  <devices>
    <family Dfamily="STM32F1 Series" Dvendor="STMicroelectronics:13">
      <device Dname="STM32F103C8">
        <memory name="IROM1" access="read" start="0x08000000" size="0x10000"/>
        <memory name="IRAM1" access="readwrite" start="0x20000000" size="0x5000"/>
        <algorithm name="STM32F10x_128.FLM" stat="0x08000000" size="0x10000"/>
      </device>
      <device Dname="STM32F103RC">
        <memory name="IROM1" access="read" start="0x08000000" size="0x40000"/>
        <memory name="IRAM1" access="readwrite" start="0x20000000" size="0xC000"/>
      </device>
      <device Dname="STM32F103VE">
        <memory name="IROM1" access="read" start="0x08000000" size="0x80000"/>
        <memory name="IRAM1" access="readwrite" start="0x20000000" size="0x10000"/>
      </device>
    </family>
    <svd>CMSIS/SVD/STM32F103xx.svd</svd>
  </devices>
</package>
